// Configuration settings for Dev Release builds
#include "Release.xcconfig"
#include "AppInfo.xcconfig"

// One bundle identifier for every flavor: dev and prod are the same app on
// different tracks, and Firebase/Google Sign-In register only this one.
PRODUCT_BUNDLE_IDENTIFIER = app.maypole.maypole
PRODUCT_NAME = maypole-dev

// App name shown to users
APP_DISPLAY_NAME = Maypole Dev
